# Copy this file to .env. Replace placeholders before starting the backend.
# Keep real credentials in .env or your hosting provider's environment settings.

NODE_ENV=development
PORT=8000

# MongoDB connection URI, including the database name.
MONGODB_URL=mongodb://127.0.0.1:27017/crm-app
# Atlas alternative: mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER/crm-app

# Firebase Admin service account (same project as the frontend web app).
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-firebase-project-id.iam.gserviceaccount.com
# Keep the quotes and escaped newlines; do not paste a real private key here.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Frontend origins for HTTP requests and Socket.IO connections.
CLIENT_URL=http://localhost:3000
SOCKET_IO_CORS_ORIGIN=http://localhost:3000
# On Render, set both origins to https://crm-frontend-taupe-six.vercel.app.
# Render supplies PORT; set NODE_ENV=production there.

# Server-only OpenAI credential. The account needs available API credits.
OPENAI_API_KEY=your-openai-api-key
# Optional; defaults to gpt-5.4-mini in services/aiService.js.
OPENAI_MODEL=gpt-5.4-mini

# CSV imports. File size is in bytes (10 MB matches the frontend upload limit).
UPLOAD_DIR=uploads/temp
MAX_FILE_SIZE=10485760
CSV_BATCH_SIZE=100
